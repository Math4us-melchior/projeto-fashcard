/* Configurações Gerais */
body {
    background-color: #44020b; /* Fundo quase preto */
    color: #300209; /* Texto branco */
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    margin: 0;
    padding: 0;
}

/* Cabeçalho */
header {
    background-color: #3a031d;
    border-bottom: 4px solid #b30000; /* Linha vermelha estilosa */
    text-align: center;
    padding: 40px 20px;
}

header h1 {
    color: #e60000; /* Vermelho vibrante */
    font-size: 3rem;
    margin: 0;
    letter-spacing: 2px;
}

header p {
    color: #410303;
    font-style: italic;
}

/* Conteúdo Principal */
main {
    max-width: 800px;
    margin: 20px auto;
    padding: 20px;
}

h2 {
    color: #e60000;
    border-left: 5px solid #e60000;
    padding-left: 10px;
}

p {
    line-height: 1.6;
    color: #dddddd;
}

/* Lista de Personagens */
ul {
    list-style-type: none;
    padding: 0;
}

li {
    background-color: #1e1e1e;
    margin: 10px 0;
    padding: 15px;
    border-radius: 5px;
    border-left: 3px solid #b30000;
}

/* Rodapé */
footer {
    text-align: center;
    padding: 20px;
    background-color: #000000;
    color: #666666;
    font-size: 0.9rem;
    margin-top: 40px;
}